PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Do not enable until a reviewed and published privacy policy is available at /privacy
SUBMISSIONS_ENABLED=false
APPROVED_PRIVACY_NOTICE_VERSION=pending
# Resend sender must use a verified domain; receiver is an approved internal inbox
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
# Set true only when deployed behind a single trusted reverse proxy
TRUST_PROXY=false
