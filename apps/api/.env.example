PORT=4000
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Public inquiry collection remains off until legal approval and staging tests.
SUBMISSIONS_ENABLED=false
APPROVED_PRIVACY_NOTICE_VERSION=pending
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
TRUST_PROXY=false
# Part 12 admin is OFF until the migration is applied and at least one Argon2id admin is bootstrapped.
ADMIN_ENABLED=false
ADMIN_CLIENT_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAME_SITE=Lax
ADMIN_COOKIE_DOMAIN=
# For externally hosted recordings, comma-separated HTTPS origins, e.g. https://media.example.org
EDITORIAL_MEDIA_ORIGINS=
