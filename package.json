{
  "name": "moundweb",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moundweb/web & npm run dev --workspace @moundweb/api",
    "dev:web": "npm run dev --workspace @moundweb/web",
    "dev:api": "npm run dev --workspace @moundweb/api",
    "build": "npm run build --workspace @moundweb/shared && npm run build --workspace @moundweb/api && npm run build --workspace @moundweb/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:browser": "playwright test",
    "db:generate": "npm run db:generate --workspace @moundweb/api",
    "db:migrate": "npm run db:migrate --workspace @moundweb/api",
    "postinstall": "npm run db:generate"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.56.1",
    "d3-geo": "^3.1.1",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "simple-icons": "16.35.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "braces": "3.0.4"
  }
}
